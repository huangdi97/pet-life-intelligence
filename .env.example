APP_ENV=development
APP_NAME=Pet Life Intelligence

API_HOST=0.0.0.0
API_PORT=8800
WEB_PORT=3000

# Local Postgres (docker compose maps host 55432 -> container 5432)
DATABASE_URL=postgresql+asyncpg://pli:pli_dev_password@localhost:55432/pli
# Database used by the automated test suite (created by tests/conftest)
TEST_DATABASE_URL=postgresql+asyncpg://pli:pli_dev_password@localhost:55432/pli_test

# Local Redis (docker compose maps host 56379 -> container 6379)
REDIS_URL=redis://localhost:56379/0

# Local MinIO (docker compose maps host 59000 -> container 9000, console 59001)
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=pli_minio
S3_SECRET_KEY=pli_minio_dev_secret
S3_BUCKET=pli-dev
S3_REGION=us-east-1
S3_SECURE=false
# storage backend: minio | local
STORAGE_BACKEND=minio
LOCAL_UPLOAD_DIR=artifacts/uploads

AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30

DEV_AUTH_ENABLED=true
DEV_AUTH_USER_ID=00000000-0000-0000-0000-000000000001

CARE_CARD_SIGNING_SECRET=CHANGE_ME_DEV_ONLY
