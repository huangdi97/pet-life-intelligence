APP_ENV=development
APP_NAME=Pet Life Intelligence

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

DATABASE_URL=postgresql+asyncpg://pli:pli_dev_password@localhost:5432/pli
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=pli_minio
S3_SECRET_KEY=pli_minio_dev_secret
S3_BUCKET=pli-dev
S3_REGION=us-east-1
S3_SECURE=false

AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30

DEV_AUTH_ENABLED=true
DEV_AUTH_USER_ID=00000000-0000-0000-0000-000000000001

CARE_CARD_SIGNING_SECRET=CHANGE_ME_DEV_ONLY
