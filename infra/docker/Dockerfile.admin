# PLI admin (Next.js) production image.
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/ui-tokens/package.json packages/ui-tokens/package.json
COPY packages/ui-tokens/tokens.json packages/ui-tokens/tokens.json
COPY packages/ui-tokens/scripts packages/ui-tokens/scripts
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --filter @pli/admin --frozen-lockfile=false

FROM deps AS build
COPY apps/admin apps/admin
COPY packages/api-client packages/api-client
COPY packages/ui-tokens packages/ui-tokens
RUN pnpm --dir packages/ui-tokens build
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --dir apps/admin build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/apps/admin/.next ./.next
COPY --from=build /app/apps/admin/node_modules ./node_modules
COPY --from=build /app/apps/admin/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
EXPOSE 3200
CMD ["pnpm", "start"]