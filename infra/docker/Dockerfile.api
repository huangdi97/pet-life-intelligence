FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv

# build deps for asyncpg
RUN apt-get update && apt-get install -y --no-install-recommends build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

# install packages first for layer caching
COPY services/api/pyproject.toml /srv/api/pyproject.toml
COPY services/ai-gateway/pyproject.toml /srv/ai-gateway/pyproject.toml
COPY packages/rules/pyproject.toml /srv/rules/pyproject.toml
COPY packages/rules/pli_rules /srv/rules/pli_rules
RUN pip install --no-cache-dir \
    -e /srv/rules \
    -e /srv/ai-gateway \
    -e /srv/api

# app code
COPY services/api /srv/api
COPY services/ai-gateway /srv/ai-gateway
COPY packages/rules /srv/rules
RUN pip install --no-cache-dir \
    -e /srv/rules \
    -e /srv/ai-gateway \
    -e /srv/api

WORKDIR /srv/api
EXPOSE 8800

# no --reload in production; graceful shutdown via lifespan
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8800", "--workers", "2", "--timeout-graceful-shutdown", "15"]