# PLI staging deployment env (haoleilab server). NO real secrets.
APP_ENV=staging
APP_NAME=Pet Life Intelligence
APP_VERSION=1.1.1

DATABASE_URL=postgresql+asyncpg://pli:CHANGE_ME_DB_PW@postgres:5432/pli
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/data/uploads

AI_PROVIDER=mock
AI_MODEL=mock-v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_BASE_URL=
AI_MAX_RETRIES=2

# real auth (Argon2id + rotating tokens)
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_DAYS=14
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# staging uses dev-auth sandbox users (owner@pli.demo etc.) + console email
DEV_AUTH_ENABLED=true
DEV_AUTH_USER_ID=00000000-0000-0000-0000-000000000001

SESSION_SECRET=CHANGE_ME_staging_session_secret_0123456789abcdef
CARE_CARD_SIGNING_SECRET=CHANGE_ME_staging_carecard_0123456789abcdef

PUBLIC_APP_URL=https://staging.haoleilab.com/pli
EMAIL_DELIVERY=console
EMAIL_FROM=noreply@pli.example.com

CORS_ORIGINS=https://staging.haoleilab.com

# pilot off for public staging (on for pilot deployment)
PILOT_MODE=false

# postgres
POSTGRES_USER=pli
POSTGRES_PASSWORD=CHANGE_ME_DB_PW
POSTGRES_DB=pli