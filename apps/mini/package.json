    "@babel/preset-typescript": "^7.24.1",
    "@tarojs/cli": "4.0.9",
    "@tarojs/taro-loader": "4.0.9",
    "@tarojs/webpack5-runner": "4.0.9",
    "@types/react": "^18.2.0",
