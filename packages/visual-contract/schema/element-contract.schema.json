{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pli.local/visual-contract/element-contract.schema.json",
  "title": "ElementSnapshot",
  "description": "One extracted element snapshot (web DOM element or Android accessibility node).",
  "type": "object",
  "required": ["id", "x", "y", "width", "height", "visible"],
  "properties": {
    "id": { "type": "string" },
    "role": { "type": "string" },
    "type": { "type": "string" },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "width": { "type": "number" },
    "height": { "type": "number" },
    "visible": { "type": "boolean" },
    "z": { "type": "number" },
    "text": { "type": "string" },
    "styles": {
      "type": "object",
      "properties": {
        "backgroundColor": { "type": "string" },
        "color": { "type": "string" },
        "fontSize": { "type": "number" },
        "fontWeight": { "type": ["string", "number"] },
        "borderRadius": { "type": "number" },
        "opacity": { "type": "number" },
        "display": { "type": "string" },
        "position": { "type": "string" },
        "zIndex": { "type": "number" },
        "overflow": { "type": "string" }
      }
    }
  }
}
