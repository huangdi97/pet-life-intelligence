{
  "screen": "special-offline",
  "version": 2,
  "dimensions": {
    "individualPetTruth": 25,
    "visualComposition": 20,
    "informationHierarchy": 15,
    "surfaceGovernance": 10,
    "contentPurity": 10,
    "interactionTruth": 10,
    "accessibility": 5,
    "pixelStyleTruth": 5
  },
  "thresholds": {
    "pass": 85
  },
  "critical": [
    "offline.state",
    "offline.content.purity",
    "offline.retry"
  ],
  "checks": [
    {
      "id": "offline.state",
      "dimension": "individualPetTruth",
      "points": 12,
      "description": "Offline 态：offline state 呈现",
      "check": {
        "kind": "element",
        "idPrefix": "pli.offline.state"
      }
    },
    {
      "id": "offline.identity",
      "dimension": "individualPetTruth",
      "points": 8,
      "description": "当前宠物身份存在",
      "check": {
        "kind": "element",
        "idPrefix": "pli.today.identity"
      }
    },
    {
      "id": "offline.composition",
      "dimension": "visualComposition",
      "points": 20,
      "description": "offline 主视觉（state+cached）",
      "check": {
        "kind": "element",
        "idPrefix": "pli.offline.*",
        "count": [
          1,
          8
        ]
      }
    },
    {
      "id": "offline.cached",
      "dimension": "informationHierarchy",
      "points": 7,
      "description": "Offline 态：cached 内容",
      "check": {
        "kind": "element",
        "idPrefix": "pli.offline.cached"
      }
    },
    {
      "id": "offline.sync",
      "dimension": "informationHierarchy",
      "points": 8,
      "description": "Offline 态：last sync",
      "check": {
        "kind": "element",
        "idPrefix": "pli.offline.last-sync"
      }
    },
    {
      "id": "offline.surface",
      "dimension": "surfaceGovernance",
      "points": 10,
      "description": "大 Card ≤3",
      "check": {
        "kind": "surface",
        "max": 3,
        "minArea": 16000
      }
    },
    {
      "id": "offline.content.purity",
      "dimension": "contentPurity",
      "points": 10,
      "description": "Owner 文本无 raw internal terms",
      "check": {
        "kind": "text-free",
        "tokens": [
          "BW-",
          "OWNER_REPORTED",
          "STRESS_RECOVERY",
          "OPEN",
          "provider_",
          "model_id",
          "event_key",
          "PLI-"
        ]
      }
    },
    {
      "id": "offline.retry",
      "dimension": "interactionTruth",
      "points": 10,
      "description": "Offline 态：retry",
      "check": {
        "kind": "element",
        "idPrefix": "pli.offline.retry"
      }
    },
    {
      "id": "offline.a11y",
      "dimension": "accessibility",
      "points": 5,
      "description": "offline 状态可读",
      "check": {
        "kind": "element",
        "idPrefix": "pli.offline.state"
      }
    },
    {
      "id": "offline.truth",
      "dimension": "individualPetTruth",
      "points": 5.0,
      "description": "offline 状态来自真实网络状态 (real data)",
      "check": {
        "kind": "text-free",
        "tokens": [
          "占位",
          "TODO",
          "placeholder"
        ]
      }
    },
    {
      "id": "offline.truth.style",
      "dimension": "pixelStyleTruth",
      "points": 5.0,
      "description": "无占位/空板书风格（style truth）",
      "check": {
        "kind": "text-free",
        "tokens": [
          "占位",
          "TODO",
          "placeholder",
          "coming soon"
        ]
      }
    }
