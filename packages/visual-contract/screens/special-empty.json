{
  "screen": "special-empty",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 85 },
  "critical": ["empty.presence", "empty.content.purity", "empty.action"],
  "checks": [
    { "id": "empty.presence", "dimension": "petIdentity", "points": 12, "description": "Empty 态：Pet Presence 存在", "check": { "kind": "element", "idPrefix": "pli.empty.pet" } },
    { "id": "empty.identity", "dimension": "petIdentity", "points": 8, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.today.identity" } },
    { "id": "empty.composition", "dimension": "composition", "points": 20, "description": "Empty 主视觉结构（pet+why）", "check": { "kind": "element", "idPrefix": "pli.empty.*", "count": [1, 6] } },
    { "id": "empty.why", "dimension": "hierarchy", "points": 15, "description": "Empty 态：为什么为空", "check": { "kind": "element", "idPrefix": "pli.empty.why" } },
    { "id": "empty.surface", "dimension": "surface", "points": 10, "description": "大 Card ≤3", "check": { "kind": "surface", "max": 3, "minArea": 16000 } },
    { "id": "empty.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "empty.action", "dimension": "interaction", "points": 10, "description": "Empty 态：一个主动作", "check": { "kind": "element", "idPrefix": "pli.empty.action" } },
    { "id": "empty.a11y", "dimension": "accessibility", "points": 5, "description": "主动作可访问", "check": { "kind": "element", "idPrefix": "pli.empty.action" } },
    { "id": "empty.truth", "dimension": "runtimeTruth", "points": 10, "description": "空态来自真实 runtime（无占位）", "check": { "kind": "text-free", "tokens": ["占位", "TODO", "placeholder"] } }
  ]
}