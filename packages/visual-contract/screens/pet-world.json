{
  "screen": "pet-world",
  "version": 2,
  "dimensions": { "individualPetTruth": 25, "visualComposition": 20, "informationHierarchy": 15, "surfaceGovernance": 10, "contentPurity": 10, "interactionTruth": 10, "accessibility": 5, "pixelStyleTruth": 5 },
  "thresholds": { "pass": 92, "heroPass": 97 },
  "critical": [
    "pet.twin.present", "pet.identity.gate", "pet.3d.origin", "pet.3d.no-fallback",
    "pet.domain.meaning", "pet.friends", "pet.caregivers", "pet.content.purity",
    "pet.projected.bounds", "pet.stage.warm"
  ],
  "checks": [
    { "id": "pet.identity", "dimension": "individualPetTruth", "points": 5, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.pet.identity" } },
    { "id": "pet.twin.present", "dimension": "individualPetTruth", "points": 6, "description": "顶部 3D Individual Twin 存在", "check": { "kind": "element", "idPrefix": "pli.pet.pet-twin", "minHeight": 180 } },
    { "id": "pet.domain.life", "dimension": "individualPetTruth", "points": 1, "description": "生命侧面「生活」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.life" } },
    { "id": "pet.domain.health", "dimension": "individualPetTruth", "points": 1, "description": "生命侧面「健康」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.health" } },
    { "id": "pet.domain.behavior", "dimension": "individualPetTruth", "points": 1, "description": "生命侧面「行为」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.behavior" } },
    { "id": "pet.domain.training", "dimension": "individualPetTruth", "points": 1, "description": "生命侧面「训练」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.training" } },
    { "id": "pet.domain.welfare", "dimension": "individualPetTruth", "points": 1, "description": "生命侧面「福利」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.welfare" } },
    { "id": "pet.domain.social", "dimension": "individualPetTruth", "points": 1, "description": "生命侧面「社交」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.social" } },
    { "id": "pet.identity.gate", "dimension": "individualPetTruth", "points": 4, "description": "Individual Identity Gate：generic=false + petId 匹配 + sourceMedia>=2", "check": { "kind": "identity", "generic": false, "petIdMatch": true, "sourceMediaMin": 2 } },
    { "id": "pet.3d.origin", "dimension": "individualPetTruth", "points": 2, "description": "manifestOrigin == RUNTIME", "check": { "kind": "manifest-origin", "eq": "RUNTIME" } },
    { "id": "pet.3d.no-fallback", "dimension": "individualPetTruth", "points": 2, "description": "fallbackUsed = false（真实 3D）", "check": { "kind": "manifest", "field": "fallbackUsed", "eq": false } },
    { "id": "pet.stage.ratio", "dimension": "visualComposition", "points": 5, "description": "Hero Stage ≥35% 内容高", "check": { "kind": "ratio", "target": "pli.pet.hero-stage", "region": "content", "property": "height", "range": [0.35, 0.6] } },
    { "id": "pet.twin.center", "dimension": "visualComposition", "points": 4, "description": "Twin 水平居中偏差 ≤10%", "check": { "kind": "center", "target": "pli.pet.pet-twin", "region": "viewport", "axis": "x", "tolerance": 0.1 } },
    { "id": "pet.hero.domains", "dimension": "visualComposition", "points": 4, "description": "Hero Stage 面积占比 30–65% 内容区", "check": { "kind": "ratio", "target": "pli.pet.hero-stage", "region": "content", "property": "area", "range": [0.3, 0.65] } },
    { "id": "pet.projected.bounds", "dimension": "visualComposition", "points": 4, "description": "真实模型投影 bbox 占视口 0.14–0.28", "check": { "kind": "manifest", "field": "projectedAreaRatio", "in": [0.14, 0.28] } },
    { "id": "pet.stage.warm", "dimension": "visualComposition", "points": 3, "description": "Pet Stage 非 dark viewer", "check": { "kind": "pixel-style", "surface": "pet" } },
    { "id": "pet.domain.meaning", "dimension": "informationHierarchy", "points": 5, "description": "六个入口均含当前含义摘要（非纯入口）", "check": { "kind": "element", "idPrefix": "pli.pet.domain.*", "count": [6, 6] } },
    { "id": "pet.friends", "dimension": "informationHierarchy", "points": 4, "description": "宠物朋友存在", "check": { "kind": "element", "idPrefix": "pli.pet.friends" } },
    { "id": "pet.caregivers", "dimension": "informationHierarchy", "points": 4, "description": "照护它的人存在", "check": { "kind": "element", "idPrefix": "pli.pet.caregivers" } },
    { "id": "pet.recent", "dimension": "informationHierarchy", "points": 2, "description": "最近/与它自己相比存在", "check": { "kind": "element", "idPrefix": "pli.pet.recent" } },
    { "id": "pet.surface.grid", "dimension": "surfaceGovernance", "points": 5, "description": "非宫格 card 表面 ≤8", "check": { "kind": "surface", "max": 8, "minArea": 12000, "surfaceType": "CARD" } },
    { "id": "pet.surface.panels", "dimension": "surfaceGovernance", "points": 5, "description": "六域为 OpenSection/rows（SOFT_PANEL ≤6）", "check": { "kind": "surface", "max": 6, "minArea": 12000, "surfaceType": "SOFT_PANEL" } },
    { "id": "pet.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "pet.domains.action", "dimension": "interactionTruth", "points": 4, "description": "六域入口可点击（role button）", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.pet.domain." }, "range": [6, 6] } },
    { "id": "pet.lifeview.entry", "dimension": "interactionTruth", "points": 3, "description": "生命视图入口存在", "check": { "kind": "element", "idPrefix": "pli.pet.entry.lifeview" } },
    { "id": "pet.stage.interactive", "dimension": "interactionTruth", "points": 3, "description": "英雄 Stage 可交互被测量", "check": { "kind": "interaction", "id": "pli.pet.hero-stage" } },
    { "id": "pet.domain.a11y", "dimension": "accessibility", "points": 5, "description": "六域入口有可读文本", "check": { "kind": "element", "idPrefix": "pli.pet.domain.*", "count": [6, 6] } },
    { "id": "pet.style.truth", "dimension": "pixelStyleTruth", "points": 3, "description": "Design-as-Data V2：hero stage computed bg 不黑", "check": { "kind": "style-truth", "idPrefix": "pli.pet.stage", "notDarkBg": true } },
    { "id": "pet.warm.pixels", "dimension": "pixelStyleTruth", "points": 2, "description": "Warm living field 像素门", "check": { "kind": "pixel-style", "surface": "pet" } }
  ]
}