{
  "screen": "pet-world",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 92, "heroPass": 95 },
  "critical": [
    "pet.twin.present", "pet.domain.meaning", "pet.friends", "pet.caregivers",
    "pet.content.purity", "pet.3d.wireframe", "pet.3d.no-fallback"
  ],
  "checks": [
    { "id": "pet.identity", "dimension": "petIdentity", "points": 6, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.pet.identity" } },
    { "id": "pet.twin.present", "dimension": "petIdentity", "points": 7, "description": "顶部 3D Individual Twin 存在", "check": { "kind": "element", "idPrefix": "pli.pet.pet-twin", "minHeight": 180 } },
    { "id": "pet.domain.life", "dimension": "petIdentity", "points": 1.5, "description": "生命侧面「生活」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.life" } },
    { "id": "pet.domain.health", "dimension": "petIdentity", "points": 1.5, "description": "生命侧面「健康」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.health" } },
    { "id": "pet.domain.behavior", "dimension": "petIdentity", "points": 1, "description": "生命侧面「行为」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.behavior" } },
    { "id": "pet.domain.training", "dimension": "petIdentity", "points": 1, "description": "生命侧面「训练」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.training" } },
    { "id": "pet.domain.welfare", "dimension": "petIdentity", "points": 1, "description": "生命侧面「福利」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.welfare" } },
    { "id": "pet.domain.social", "dimension": "petIdentity", "points": 1, "description": "生命侧面「社交」", "check": { "kind": "element", "idPrefix": "pli.pet.domain.social" } },
    { "id": "pet.stage.ratio", "dimension": "composition", "points": 8, "description": "Hero Stage ≥35% 内容高", "check": { "kind": "ratio", "target": "pli.pet.hero-stage", "region": "content", "property": "height", "range": [0.35, 0.6] } },
    { "id": "pet.twin.center", "dimension": "composition", "points": 6, "description": "Twin 水平居中偏差 ≤10%", "check": { "kind": "center", "target": "pli.pet.pet-twin", "region": "viewport", "axis": "x", "tolerance": 0.1 } },
    { "id": "pet.hero.domains", "dimension": "composition", "points": 6, "description": "Hero Stage 面积占比 30–65% 内容区", "check": { "kind": "ratio", "target": "pli.pet.hero-stage", "region": "content", "property": "area", "range": [0.3, 0.65] } },
    { "id": "pet.domain.meaning", "dimension": "hierarchy", "points": 7, "description": "六个入口均含当前含义摘要（非纯入口）", "check": { "kind": "element", "idPrefix": "pli.pet.domain.*", "count": [6, 6] } },
    { "id": "pet.friends", "dimension": "hierarchy", "points": 4, "description": "宠物朋友存在", "check": { "kind": "element", "idPrefix": "pli.pet.friends" } },
    { "id": "pet.caregivers", "dimension": "hierarchy", "points": 4, "description": "照护它的人存在", "check": { "kind": "element", "idPrefix": "pli.pet.caregivers" } },
    { "id": "pet.surface.grid", "dimension": "surface", "points": 10, "description": "非宫格：card 表面 ≤8", "check": { "kind": "surface", "max": 8, "minArea": 12000 } },
    { "id": "pet.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "pet.domains.action", "dimension": "interaction", "points": 6, "description": "六域入口可点击（role button）", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.pet.domain." }, "range": [6, 6] } },
    { "id": "pet.lifeview.entry", "dimension": "interaction", "points": 4, "description": "生命视图入口存在", "check": { "kind": "element", "idPrefix": "pli.pet.entry.lifeview" } },
    { "id": "pet.domain.a11y", "dimension": "accessibility", "points": 5, "description": "六域入口有可读文本", "check": { "kind": "element", "idPrefix": "pli.pet.domain.*", "count": [6, 6] } },
    { "id": "pet.3d.manifest", "dimension": "runtimeTruth", "points": 4, "description": "3D Scene Manifest 存在", "check": { "kind": "manifest", "field": "ready", "truthy": true, "unlessPlatform": ["android"] } },
    { "id": "pet.3d.wireframe", "dimension": "runtimeTruth", "points": 3, "description": "wireframe = false", "check": { "kind": "manifest", "field": "wireframe", "eq": false } },
    { "id": "pet.3d.no-fallback", "dimension": "runtimeTruth", "points": 3, "description": "fallbackUsed = false（真实 3D）", "check": { "kind": "manifest", "field": "fallbackUsed", "eq": false, "unlessPlatform": ["android"] } }
  ]
}
