{
  "screen": "me",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 92 },
  "critical": ["me.content.purity", "me.owner"],
  "checks": [
    { "id": "me.owner", "dimension": "petIdentity", "points": 10, "description": "Owner 身份存在", "check": { "kind": "element", "idPrefix": "pli.me.owner" } },
    { "id": "me.pets", "dimension": "petIdentity", "points": 10, "description": "我的宠物存在", "check": { "kind": "element", "idPrefix": "pli.me.pets" } },
    { "id": "me.care-network", "dimension": "composition", "points": 7, "description": "家庭 / Care Network 存在", "check": { "kind": "element", "idPrefix": "pli.me.care-network" } },
    { "id": "me.notifications", "dimension": "composition", "points": 5, "description": "通知存在", "check": { "kind": "element", "idPrefix": "pli.me.notifications" } },
    { "id": "me.privacy", "dimension": "composition", "points": 5, "description": "隐私存在", "check": { "kind": "element", "idPrefix": "pli.me.privacy" } },
    { "id": "me.data", "dimension": "composition", "points": 3, "description": "数据存在", "check": { "kind": "element", "idPrefix": "pli.me.data" } },
    { "id": "me.help", "dimension": "hierarchy", "points": 7, "description": "帮助存在", "check": { "kind": "element", "idPrefix": "pli.me.help" } },
    { "id": "me.hierarchy", "dimension": "hierarchy", "points": 8, "description": "Owner 区为主（我的宠物在前）", "check": { "kind": "element", "idPrefix": "pli.me.pets" } },
    { "id": "me.surface", "dimension": "surface", "points": 10, "description": "大 Card ≤6", "check": { "kind": "surface", "max": 6, "minArea": 16000 } },
    { "id": "me.content.purity", "dimension": "contentPurity", "points": 10, "description": "无开发模式/raw env/test pet list", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-", "开发模式", "测试宠物", "DEBUG", "Internal / Pre-Pilot"] } },
    { "id": "me.pets.action", "dimension": "interaction", "points": 5, "description": "宠物列表可进入", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.me.pets" }, "range": [1, 4] } },
    { "id": "me.settings.action", "dimension": "interaction", "points": 5, "description": "设置项可进入", "check": { "kind": "element", "idPrefix": "pli.me.settings" } },
    { "id": "me.a11y", "dimension": "accessibility", "points": 5, "description": "关键项可访问", "check": { "kind": "element", "idPrefix": "pli.me.owner" } },
    { "id": "me.truth", "dimension": "runtimeTruth", "points": 10, "description": "Owner/宠物来自真实 runtime", "check": { "kind": "text-free", "tokens": ["占位", "TODO", "placeholder"] } }
  ]
}
