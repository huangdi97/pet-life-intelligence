{
  "screen": "special-multipet",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 85 },
  "critical": ["multipet.current", "multipet.content.purity", "multipet.switch"],
  "checks": [
    { "id": "multipet.current", "dimension": "petIdentity", "points": 12, "description": "Multi-pet 态：current pet 呈现", "check": { "kind": "element", "idPrefix": "pli.multipet.current" } },
    { "id": "multipet.identity", "dimension": "petIdentity", "points": 8, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.pet.identity" } },
    { "id": "multipet.composition", "dimension": "composition", "points": 20, "description": "多宠切换主视觉存在", "check": { "kind": "element", "idPrefix": "pli.multipet.*", "count": [1, 6] } },
    { "id": "multipet.names", "dimension": "hierarchy", "points": 15, "description": "宠物名称来自 runtime（≥1 宠物列表）", "check": { "kind": "element", "idPrefix": "pli.multipet.switch.*" } },
    { "id": "multipet.surface", "dimension": "surface", "points": 10, "description": "大 Card ≤6", "check": { "kind": "surface", "max": 6, "minArea": 16000 } },
    { "id": "multipet.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "multipet.switch", "dimension": "interaction", "points": 10, "description": "Multi-pet 态：switch 存在", "check": { "kind": "element", "idPrefix": "pli.multipet.switch" } },
    { "id": "multipet.a11y", "dimension": "accessibility", "points": 5, "description": "current pet 可读", "check": { "kind": "element", "idPrefix": "pli.multipet.current" } },
    { "id": "multipet.truth", "dimension": "runtimeTruth", "points": 10, "description": "当前宠物来自真实 runtime", "check": { "kind": "text-free", "tokens": ["占位", "TODO", "placeholder", "测试宠物"] } }
  ]
}