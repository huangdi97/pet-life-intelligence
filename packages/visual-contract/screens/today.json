{
  "screen": "today",
  "version": 2,
  "dimensions": { "individualPetTruth": 25, "visualComposition": 20, "informationHierarchy": 15, "surfaceGovernance": 10, "contentPurity": 10, "interactionTruth": 10, "accessibility": 5, "pixelStyleTruth": 5 },
  "thresholds": { "pass": 92, "heroPass": 97 },
  "critical": [
    "today.identity", "today.twin.present", "today.anchor.water", "today.anchor.food",
    "today.anchor.activity", "today.anchor.sleep", "today.identity.gate", "today.3d.origin",
    "today.3d.no-fallback", "today.3d.wireframe", "today.projected.bounds", "today.stage.warm",
    "today.health.separate", "today.attention.one", "today.surface.cards", "today.content.purity",
    "today.nav.five"
  ],
  "checks": [
    { "id": "today.identity", "dimension": "individualPetTruth", "points": 3, "description": "当前宠物身份（currentPet.name/avatar/species）存在", "check": { "kind": "element", "idPrefix": "pli.today.identity" } },
    { "id": "today.twin.present", "dimension": "individualPetTruth", "points": 5, "description": "个体 Pet Twin 元素存在", "check": { "kind": "element", "idPrefix": "pli.today.pet-twin", "minHeight": 150 } },
    { "id": "today.anchor.water", "dimension": "individualPetTruth", "points": 1, "description": "基础状态「饮水」存在", "check": { "kind": "element", "idPrefix": "pli.today.anchor.water" } },
    { "id": "today.anchor.food", "dimension": "individualPetTruth", "points": 1, "description": "基础状态「进食」存在", "check": { "kind": "element", "idPrefix": "pli.today.anchor.food" } },
    { "id": "today.anchor.activity", "dimension": "individualPetTruth", "points": 1, "description": "基础状态「活动」存在", "check": { "kind": "element", "idPrefix": "pli.today.anchor.activity" } },
    { "id": "today.anchor.sleep", "dimension": "individualPetTruth", "points": 1, "description": "基础状态「睡眠」存在", "check": { "kind": "element", "idPrefix": "pli.today.anchor.sleep" } },
    { "id": "today.identity.gate", "dimension": "individualPetTruth", "points": 4, "description": "Individual Identity Gate：generic=false + petId 匹配 + sourceMedia>=2", "check": { "kind": "identity", "generic": false, "petIdMatch": true, "sourceMediaMin": 2 } },
    { "id": "today.3d.origin", "dimension": "individualPetTruth", "points": 3, "description": "manifestOrigin == RUNTIME（非合成 fallback）", "check": { "kind": "manifest-origin", "eq": "RUNTIME" } },
    { "id": "today.3d.no-fallback", "dimension": "individualPetTruth", "points": 3, "description": "fallbackUsed = false（真实 3D）", "check": { "kind": "manifest", "field": "fallbackUsed", "eq": false } },
    { "id": "today.3d.wireframe", "dimension": "individualPetTruth", "points": 3, "description": "wireframe = false / 非线框", "check": { "kind": "manifest", "field": "wireframe", "eq": false } },
    { "id": "today.stage.interactive", "dimension": "interactionTruth", "points": 3, "description": "Living Stage 可交互被测量", "check": { "kind": "interaction", "id": "pli.today.living-stage" } },
    { "id": "today.twin.center", "dimension": "visualComposition", "points": 4, "description": "Twin 水平居中偏差 ≤10% 视口宽", "check": { "kind": "center", "target": "pli.today.pet-twin", "region": "viewport", "axis": "x", "tolerance": 0.1 } },
    { "id": "today.projected.bounds", "dimension": "visualComposition", "points": 5, "description": "真实模型投影 bbox 占视口 0.10–0.24（projectedPetBounds）", "check": { "kind": "manifest", "field": "projectedAreaRatio", "in": [0.1, 0.24] } },
    { "id": "today.stage.warm", "dimension": "visualComposition", "points": 5, "description": "Today Stage 非 dark viewer：stageLuma 达暖环境阈值或 realityField media", "check": { "kind": "pixel-style", "surface": "today", "allowRealityMedia": true } },
    { "id": "today.health.separate", "dimension": "informationHierarchy", "points": 5, "description": "健康摘要独立于四基础状态", "check": { "kind": "element", "idPrefix": "pli.today.health-summary" } },
    { "id": "today.attention.one", "dimension": "informationHierarchy", "points": 4, "description": "注意点 ≤1 个", "check": { "kind": "element", "idPrefix": "pli.today.attention", "count": [0, 1] } },
    { "id": "today.change", "dimension": "informationHierarchy", "points": 3, "description": "变化叙事（Change）存在", "check": { "kind": "element", "idPrefix": "pli.today.change" } },
    { "id": "today.memory", "dimension": "informationHierarchy", "points": 3, "description": "最近发生（Memory）预览存在", "check": { "kind": "element", "idPrefix": "pli.today.memory-preview" } },
    { "id": "today.surface.cards", "dimension": "surfaceGovernance", "points": 5, "description": "Above-fold 大 CARD ≤1（Card Dashboard Gate V2）", "check": { "kind": "surface", "max": 1, "minArea": 20000, "aboveFold": true, "surfaceType": "CARD" } },
    { "id": "today.surface.panels", "dimension": "surfaceGovernance", "points": 5, "description": "Above-fold SOFT_PANEL ≤2", "check": { "kind": "surface", "max": 2, "minArea": 20000, "aboveFold": true, "surfaceType": "SOFT_PANEL" } },
    { "id": "today.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "today.nav.five", "dimension": "interactionTruth", "points": 4, "description": "底导 5 项（今天/时间线/当前宠物/助手/我的）", "check": { "kind": "element", "idPrefix": "pli.nav.*", "count": [5, 5] } },
    { "id": "today.primary-action", "dimension": "interactionTruth", "points": 3, "description": "主动作「快速记录」存在", "check": { "kind": "element", "idPrefix": "pli.today.primary-action" } },
    { "id": "today.stage.ratio", "dimension": "visualComposition", "points": 6, "description": "Living Stage 高 = 内容区 43–53%", "check": { "kind": "ratio", "target": "pli.today.living-stage", "region": "content", "property": "height", "range": [0.43, 0.53] } },
    { "id": "today.nav.a11y", "dimension": "accessibility", "points": 3, "description": "底导 5 项为可访问按钮", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.nav." }, "range": [5, 5] } },
    { "id": "today.anchor.a11y", "dimension": "accessibility", "points": 2, "description": "四个锚点均有可读文本", "check": { "kind": "element", "idPrefix": "pli.today.anchor.*", "count": [4, 4] } },
    { "id": "today.style.truth", "dimension": "pixelStyleTruth", "points": 3, "description": "Design-as-Data V2：stage 声明 warm 但 computed bg 不黑", "check": { "kind": "style-truth", "idPrefix": "pli.today.living-stage", "notDarkBg": true } },
    { "id": "today.warm.pixels", "dimension": "pixelStyleTruth", "points": 2, "description": "Warm living field：白色大卡占比与暖色不冲突", "check": { "kind": "pixel-style", "surface": "other" } }
  ]
}