{
  "screen": "assistant",
  "version": 2,
  "dimensions": {
    "individualPetTruth": 25,
    "visualComposition": 20,
    "informationHierarchy": 15,
    "surfaceGovernance": 10,
    "contentPurity": 10,
    "interactionTruth": 10,
    "accessibility": 5,
    "pixelStyleTruth": 5
  },
  "thresholds": {
    "pass": 92
  },
  "critical": [
    "assistant.context",
    "assistant.content.purity"
  ],
  "checks": [
    {
      "id": "assistant.identity",
      "dimension": "individualPetTruth",
      "points": 8,
      "description": "当前宠物身份存在",
      "check": {
        "kind": "element",
        "idPrefix": "pli.assistant.identity"
      }
    },
    {
      "id": "assistant.context",
      "dimension": "individualPetTruth",
      "points": 12,
      "description": "当前宠物上下文（recent context + change）",
      "check": {
        "kind": "element",
        "idPrefix": "pli.assistant.context"
      }
    },
    {
      "id": "assistant.suggestions",
      "dimension": "visualComposition",
      "points": 12,
      "description": "建议动作（解释变化/总结/查看记录/计划下一步）",
      "check": {
        "kind": "element",
        "idPrefix": "pli.assistant.suggestion.*",
        "count": [
          3,
          6
        ]
      }
    },
    {
      "id": "assistant.chat",
      "dimension": "visualComposition",
      "points": 8,
      "description": "对话区存在",
      "check": {
        "kind": "element",
        "idPrefix": "pli.assistant.chat"
      }
    },
    {
      "id": "assistant.ask",
      "dimension": "informationHierarchy",
      "points": 5,
      "description": "输入/提问区存在",
      "check": {
        "kind": "element",
        "idPrefix": "pli.assistant.ask"
      }
    },
    {
      "id": "assistant.explain",
      "dimension": "informationHierarchy",
      "points": 5,
      "description": "解释入口存在",
      "check": {
        "kind": "element",
        "idPrefix": "pli.assistant.suggestion.explain"
      }
    },
    {
      "id": "assistant.plan",
      "dimension": "informationHierarchy",
      "points": 5,
      "description": "计划入口存在",
      "check": {
        "kind": "element",
        "idPrefix": "pli.assistant.suggestion.plan"
      }
    },
    {
      "id": "assistant.surface",
      "dimension": "surfaceGovernance",
      "points": 10,
      "description": "大 Card ≤4",
      "check": {
        "kind": "surface",
        "max": 4,
        "minArea": 16000
      }
    },
    {
      "id": "assistant.content.purity",
      "dimension": "contentPurity",
      "points": 10,
      "description": "无 provider/debug/model 信息",
      "check": {
        "kind": "text-free",
        "tokens": [
          "BW-",
          "OWNER_REPORTED",
          "STRESS_RECOVERY",
          "OPEN",
          "provider_",
          "model_id",
          "event_key",
          "PLI-",
          "debug",
          "开发模式"
        ]
      }
    },
    {
      "id": "assistant.suggestion.action",
      "dimension": "interactionTruth",
      "points": 5,
      "description": "建议动作可点",
      "check": {
        "kind": "count",
        "filter": {
          "role": "button",
          "idPrefix": "pli.assistant.suggestion."
        },
        "range": [
          3,
          6
        ]
      }
    },
    {
      "id": "assistant.send",
      "dimension": "interactionTruth",
      "points": 5,
      "description": "发送动作存在",
      "check": {
        "kind": "element",
        "idPrefix": "pli.assistant.send"
      }
    },
    {
      "id": "assistant.a11y",
      "dimension": "accessibility",
      "points": 5,
      "description": "建议动作可访问",
      "check": {
        "kind": "count",
        "filter": {
          "role": "button",
          "idPrefix": "pli.assistant.suggestion."
        },
        "range": [
          3,
          6
        ]
      }
    },
    {
      "id": "assistant.truth",
      "dimension": "individualPetTruth",
      "points": 5.0,
      "description": "上下文来自真实 runtime（非 generic 克隆） (real data)",
      "check": {
        "kind": "text-free",
        "tokens": [
          "占位",
          "TODO",
          "placeholder",
          "hello"
        ]
      }
    },
    {
      "id": "assistant.truth.style",
      "dimension": "pixelStyleTruth",
      "points": 5.0,
      "description": "无占位/空板书风格（style truth）",
      "check": {
        "kind": "text-free",
        "tokens": [
          "占位",
          "TODO",
          "placeholder",
          "coming soon"
        ]
