{
  "screen": "assistant",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 92 },
  "critical": ["assistant.context", "assistant.content.purity"],
  "checks": [
    { "id": "assistant.identity", "dimension": "petIdentity", "points": 8, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.assistant.identity" } },
    { "id": "assistant.context", "dimension": "petIdentity", "points": 12, "description": "当前宠物上下文（recent context + change）", "check": { "kind": "element", "idPrefix": "pli.assistant.context" } },
    { "id": "assistant.suggestions", "dimension": "composition", "points": 12, "description": "建议动作（解释变化/总结/查看记录/计划下一步）", "check": { "kind": "element", "idPrefix": "pli.assistant.suggestion.*", "count": [3, 6] } },
    { "id": "assistant.chat", "dimension": "composition", "points": 8, "description": "对话区存在", "check": { "kind": "element", "idPrefix": "pli.assistant.chat" } },
    { "id": "assistant.ask", "dimension": "hierarchy", "points": 5, "description": "输入/提问区存在", "check": { "kind": "element", "idPrefix": "pli.assistant.ask" } },
    { "id": "assistant.explain", "dimension": "hierarchy", "points": 5, "description": "解释入口存在", "check": { "kind": "element", "idPrefix": "pli.assistant.suggestion.explain" } },
    { "id": "assistant.plan", "dimension": "hierarchy", "points": 5, "description": "计划入口存在", "check": { "kind": "element", "idPrefix": "pli.assistant.suggestion.plan" } },
    { "id": "assistant.surface", "dimension": "surface", "points": 10, "description": "大 Card ≤4", "check": { "kind": "surface", "max": 4, "minArea": 16000 } },
    { "id": "assistant.content.purity", "dimension": "contentPurity", "points": 10, "description": "无 provider/debug/model 信息", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-", "debug", "开发模式"] } },
    { "id": "assistant.suggestion.action", "dimension": "interaction", "points": 5, "description": "建议动作可点", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.assistant.suggestion." }, "range": [3, 6] } },
    { "id": "assistant.send", "dimension": "interaction", "points": 5, "description": "发送动作存在", "check": { "kind": "element", "idPrefix": "pli.assistant.send" } },
    { "id": "assistant.a11y", "dimension": "accessibility", "points": 5, "description": "建议动作可访问", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.assistant.suggestion." }, "range": [3, 6] } },
    { "id": "assistant.truth", "dimension": "runtimeTruth", "points": 10, "description": "上下文来自真实 runtime（非 generic 克隆）", "check": { "kind": "text-free", "tokens": ["占位", "TODO", "placeholder", "hello"] } }
  ]
}
