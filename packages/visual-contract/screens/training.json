{
  "screen": "training",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 92 },
  "critical": ["training.content.purity", "training.goal"],
  "checks": [
    { "id": "training.identity", "dimension": "petIdentity", "points": 8, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.training.identity" } },
    { "id": "training.goal", "dimension": "petIdentity", "points": 12, "description": "当前目标存在", "check": { "kind": "element", "idPrefix": "pli.training.goal" } },
    { "id": "training.progress", "dimension": "composition", "points": 8, "description": "进度存在", "check": { "kind": "element", "idPrefix": "pli.training.progress" } },
    { "id": "training.recent", "dimension": "composition", "points": 6, "description": "最近训练存在", "check": { "kind": "element", "idPrefix": "pli.training.recent" } },
    { "id": "training.reward", "dimension": "composition", "points": 6, "description": "奖励偏好存在", "check": { "kind": "element", "idPrefix": "pli.training.reward" } },
    { "id": "training.next", "dimension": "hierarchy", "points": 7, "description": "下一步存在", "check": { "kind": "element", "idPrefix": "pli.training.next" } },
    { "id": "training.localized", "dimension": "hierarchy", "points": 4, "description": "目标状态已本地化", "check": { "kind": "element", "idPrefix": "pli.training.goal" } },
    { "id": "training.meaning", "dimension": "hierarchy", "points": 4, "description": "训练条目有含义", "check": { "kind": "element", "idPrefix": "pli.training.recent" } },
    { "id": "training.surface", "dimension": "surface", "points": 10, "description": "大 Card ≤5", "check": { "kind": "surface", "max": 5, "minArea": 16000 } },
    { "id": "training.content.purity", "dimension": "contentPurity", "points": 10, "description": "无 raw OPEN/PAUSED/ACTIVE 等", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "PAUSED", "ACTIVE", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "training.action", "dimension": "interaction", "points": 5, "description": "记录训练入口存在", "check": { "kind": "element", "idPrefix": "pli.training.action" } },
    { "id": "training.view", "dimension": "interaction", "points": 5, "description": "目标可查看", "check": { "kind": "element", "idPrefix": "pli.training.goal", "count": [1, 6] } },
    { "id": "training.a11y", "dimension": "accessibility", "points": 5, "description": "关键区可读", "check": { "kind": "element", "idPrefix": "pli.training.goal" } },
    { "id": "training.truth", "dimension": "runtimeTruth", "points": 10, "description": "目标/进度来自真实 runtime", "check": { "kind": "text-free", "tokens": ["占位", "TODO", "placeholder", "coming soon"] } }
  ]
}
