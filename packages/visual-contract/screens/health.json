{
  "screen": "health",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 92 },
  "critical": ["health.overview", "health.content.purity"],
  "checks": [
    { "id": "health.identity", "dimension": "petIdentity", "points": 8, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.health.identity" } },
    { "id": "health.overview", "dimension": "petIdentity", "points": 12, "description": "近期状态概览存在（非空页+一条状态）", "check": { "kind": "element", "idPrefix": "pli.health.overview" } },
    { "id": "health.changes", "dimension": "composition", "points": 8, "description": "近期变化区存在", "check": { "kind": "element", "idPrefix": "pli.health.changes" } },
    { "id": "health.prevent", "dimension": "composition", "points": 6, "description": "预防与计划区存在", "check": { "kind": "element", "idPrefix": "pli.health.prevent" } },
    { "id": "health.medication", "dimension": "composition", "points": 6, "description": "用药区存在", "check": { "kind": "element", "idPrefix": "pli.health.medication" } },
    { "id": "health.records", "dimension": "hierarchy", "points": 5, "description": "近期健康记录存在", "check": { "kind": "element", "idPrefix": "pli.health.records" } },
    { "id": "health.vet", "dimension": "hierarchy", "points": 5, "description": "就诊摘要/Vet Brief 入口存在", "check": { "kind": "element", "idPrefix": "pli.health.vet" } },
    { "id": "health.hierarchy", "dimension": "hierarchy", "points": 5, "description": "无真实数据模块不 fake", "check": { "kind": "text-free", "tokens": ["占位", "TODO", "placeholder", "coming soon"] } },
    { "id": "health.surface", "dimension": "surface", "points": 10, "description": "大 Card ≤5（不逐条独立 Card）", "check": { "kind": "surface", "max": 5, "minArea": 16000 } },
    { "id": "health.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "health.action", "dimension": "interaction", "points": 5, "description": "记录健康入口存在", "check": { "kind": "element", "idPrefix": "pli.health.action" } },
    { "id": "health.record.action", "dimension": "interaction", "points": 5, "description": "记录可查看", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.health.records" }, "range": [1, 12] } },
    { "id": "health.a11y", "dimension": "accessibility", "points": 5, "description": "关键区可读", "check": { "kind": "element", "idPrefix": "pli.health.overview" } },
    { "id": "health.truth", "dimension": "runtimeTruth", "points": 10, "description": "状态/记录来自真实 runtime", "check": { "kind": "element", "idPrefix": "pli.health.status" } }
  ]
}
