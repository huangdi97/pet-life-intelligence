{
  "screen": "social",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 92 },
  "critical": ["social.friends", "social.content.purity"],
  "checks": [
    { "id": "social.identity", "dimension": "petIdentity", "points": 8, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.social.identity" } },
    { "id": "social.friends", "dimension": "petIdentity", "points": 12, "description": "宠物朋友存在（1–2 可解释好友）", "check": { "kind": "element", "idPrefix": "pli.social.friends", "count": [1, 3] } },
    { "id": "social.interactions", "dimension": "composition", "points": 10, "description": "最近互动存在", "check": { "kind": "element", "idPrefix": "pli.social.interactions" } },
    { "id": "social.preferences", "dimension": "composition", "points": 10, "description": "社交偏好存在", "check": { "kind": "element", "idPrefix": "pli.social.preferences" } },
    { "id": "social.meaning", "dimension": "hierarchy", "points": 5, "description": "关系有含义", "check": { "kind": "element", "idPrefix": "pli.social.friends" } },
    { "id": "social.role", "dimension": "hierarchy", "points": 5, "description": "关系角色/最近互动描述", "check": { "kind": "element", "idPrefix": "pli.social.interactions" } },
    { "id": "social.nofeed", "dimension": "hierarchy", "points": 5, "description": "非公开 Feed（无全站内容）", "check": { "kind": "text-free", "tokens": ["广场", "全部用户", "发现宠物"] } },
    { "id": "social.surface", "dimension": "surface", "points": 10, "description": "大 Card ≤5", "check": { "kind": "surface", "max": 5, "minArea": 16000 } },
    { "id": "social.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "social.action", "dimension": "interaction", "points": 5, "description": "记录互动入口存在", "check": { "kind": "element", "idPrefix": "pli.social.action" } },
    { "id": "social.view", "dimension": "interaction", "points": 5, "description": "朋友可查看", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.social.friends" }, "range": [1, 3] } },
    { "id": "social.a11y", "dimension": "accessibility", "points": 5, "description": "朋友卡片可读", "check": { "kind": "element", "idPrefix": "pli.social.friends" } },
    { "id": "social.truth", "dimension": "runtimeTruth", "points": 10, "description": "关系来自真实 runtime（非测试宠物列表）", "check": { "kind": "text-free", "tokens": ["占位", "TODO", "placeholder", "测试宠物"] } }
  ]
}
