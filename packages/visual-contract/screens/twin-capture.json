{
  "screen": "twin-capture",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 92 },
  "critical": ["capture.views.six", "capture.content.purity"],
  "checks": [
    { "id": "capture.identity", "dimension": "petIdentity", "points": 8, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.twincapture.identity" } },
    { "id": "capture.title", "dimension": "petIdentity", "points": 4, "description": "拍摄引导标题存在", "check": { "kind": "element", "idPrefix": "pli.twincapture.title" } },
    { "id": "capture.preview", "dimension": "petIdentity", "points": 8, "description": "预览/示例存在", "check": { "kind": "element", "idPrefix": "pli.twincapture.preview" } },
    { "id": "capture.views.six", "dimension": "composition", "points": 12, "description": "六视图（正面/左侧/右侧/背面/全身/头部）", "check": { "kind": "element", "idPrefix": "pli.twincapture.view.*", "count": [6, 6] } },
    { "id": "capture.qc", "dimension": "composition", "points": 8, "description": "QC 区存在", "check": { "kind": "element", "idPrefix": "pli.twincapture.qc" } },
    { "id": "capture.states", "dimension": "hierarchy", "points": 5, "description": "每视图 complete/missing 状态", "check": { "kind": "element", "idPrefix": "pli.twincapture.view.*", "count": [6, 6] } },
    { "id": "capture.qc.dims", "dimension": "hierarchy", "points": 5, "description": "QC 维度（清晰度/遮挡/覆盖/身份一致性）", "check": { "kind": "element", "idPrefix": "pli.twincapture.qc.*", "count": [1, 8] } },
    { "id": "capture.retake", "dimension": "hierarchy", "points": 5, "description": "缺失时重拍指导存在", "check": { "kind": "element", "idPrefix": "pli.twincapture.retake" } },
    { "id": "capture.surface", "dimension": "surface", "points": 10, "description": "大 Card ≤3", "check": { "kind": "surface", "max": 3, "minArea": 20000 } },
    { "id": "capture.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "capture.action", "dimension": "interaction", "points": 5, "description": "拍摄/上传主动作存在", "check": { "kind": "element", "idPrefix": "pli.twincapture.action" } },
    { "id": "capture.retake.action", "dimension": "interaction", "points": 5, "description": "重拍动作可点", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.twincapture.retake" }, "range": [1, 3] } },
    { "id": "capture.a11y", "dimension": "accessibility", "points": 5, "description": "视图元素可读", "check": { "kind": "element", "idPrefix": "pli.twincapture.view.*", "count": [6, 6] } },
    { "id": "capture.truth", "dimension": "runtimeTruth", "points": 10, "description": "六视图状态来自真实拍摄状态", "check": { "kind": "element", "idPrefix": "pli.twincapture.status.*", "count": [6, 6] } }
  ]
}
