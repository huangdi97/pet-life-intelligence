{
  "screen": "life-view",
  "version": 2,
  "dimensions": { "individualPetTruth": 25, "visualComposition": 20, "informationHierarchy": 15, "surfaceGovernance": 10, "contentPurity": 10, "interactionTruth": 10, "accessibility": 5, "pixelStyleTruth": 5 },
  "thresholds": { "pass": 92, "heroPass": 97 },
  "critical": [
    "life.stage", "life.twin.present", "life.anchors", "life.identity.gate", "life.3d.origin",
    "life.3d.no-fallback", "life.camera.rotate", "life.camera.zoom", "life.camera.reset",
    "life.content.purity", "life.mode.now"
  ],
  "checks": [
    { "id": "life.stage", "dimension": "individualPetTruth", "points": 4, "description": "Twin Space Stage 存在", "check": { "kind": "element", "idPrefix": "pli.lifeview.stage", "minHeight": 200 } },
    { "id": "life.twin.present", "dimension": "individualPetTruth", "points": 6, "description": "个体 3D Twin 存在", "check": { "kind": "element", "idPrefix": "pli.lifeview.twin", "minHeight": 200 } },
    { "id": "life.identity", "dimension": "individualPetTruth", "points": 3, "description": "当前宠物身份存在", "check": { "kind": "element", "idPrefix": "pli.lifeview.identity" } },
    { "id": "life.anchors", "dimension": "individualPetTruth", "points": 4, "description": "锚点 2–4 个（默认不铺满）", "check": { "kind": "element", "idPrefix": "pli.lifeview.anchor.*", "count": [2, 4] } },
    { "id": "life.identity.gate", "dimension": "individualPetTruth", "points": 4, "description": "Individual Identity Gate：generic=false + petId 匹配 + sourceMedia>=2", "check": { "kind": "identity", "generic": false, "petIdMatch": true, "sourceMediaMin": 2 } },
    { "id": "life.3d.origin", "dimension": "individualPetTruth", "points": 2, "description": "manifestOrigin == RUNTIME", "check": { "kind": "manifest-origin", "eq": "RUNTIME" } },
    { "id": "life.3d.no-fallback", "dimension": "individualPetTruth", "points": 2, "description": "fallbackUsed = false（真实 3D）", "check": { "kind": "manifest", "field": "fallbackUsed", "eq": false } },
    { "id": "life.stage.ratio", "dimension": "visualComposition", "points": 5, "description": "3D Stage ≥52% 内容高", "check": { "kind": "ratio", "target": "pli.lifeview.stage", "region": "content", "property": "height", "range": [0.52, 0.72] } },
    { "id": "life.twin.center", "dimension": "visualComposition", "points": 4, "description": "Twin 水平居中偏差 ≤10%", "check": { "kind": "center", "target": "pli.lifeview.twin", "region": "viewport", "axis": "x", "tolerance": 0.1 } },
    { "id": "life.stage.dominant", "dimension": "visualComposition", "points": 4, "description": "3D Stage 面积占比 22–42% 视口", "check": { "kind": "ratio", "target": "pli.lifeview.stage", "region": "viewport", "property": "area", "range": [0.22, 0.42] } },
    { "id": "life.projected.bounds", "dimension": "visualComposition", "points": 4, "description": "真实模型投影 bbox 占视口 0.18–0.36", "check": { "kind": "manifest", "field": "projectedAreaRatio", "in": [0.18, 0.36] } },
    { "id": "life.stage.field", "dimension": "visualComposition", "points": 3, "description": "Life View 允许稍暗 warm digital field，非纯黑", "check": { "kind": "pixel-style", "surface": "lifeview" } },
    { "id": "life.mode.now", "dimension": "informationHierarchy", "points": 4, "description": "模式「此刻」可用", "check": { "kind": "element", "idPrefix": "pli.lifeview.mode.now" } },
    { "id": "life.modes", "dimension": "informationHierarchy", "points": 4, "description": "模式切换器存在（此刻/趋势/时间线/外观）", "check": { "kind": "element", "idPrefix": "pli.lifeview.mode.*", "count": [4, 4] } },
    { "id": "life.panel", "dimension": "informationHierarchy", "points": 4, "description": "事实面板存在", "check": { "kind": "element", "idPrefix": "pli.lifeview.panel" } },
    { "id": "life.context", "dimension": "informationHierarchy", "points": 3, "description": "当前状态 context 存在（与 twin 关联）", "check": { "kind": "element", "idPrefix": "pli.lifeview.anchor.*", "count": [2, 4] } },
    { "id": "life.surface.cards", "dimension": "surfaceGovernance", "points": 5, "description": "Above-fold 大 CARD ≤1", "check": { "kind": "surface", "max": 1, "minArea": 20000, "aboveFold": true, "surfaceType": "CARD" } },
    { "id": "life.surface.panels", "dimension": "surfaceGovernance", "points": 5, "description": "Above-fold SOFT_PANEL ≤2", "check": { "kind": "surface", "max": 2, "minArea": 20000, "aboveFold": true, "surfaceType": "SOFT_PANEL" } },
    { "id": "life.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms / 无演示3D文案", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-", "演示 3D", "未来连接真实服务"] } },
    { "id": "life.camera.rotate", "dimension": "interactionTruth", "points": 4, "description": "真实旋转：yaw A/B 差值实测", "check": { "kind": "camera", "event": "rotate", "field": "yaw", "minDelta": 0.03 } },
    { "id": "life.camera.zoom", "dimension": "interactionTruth", "points": 3, "description": "真实缩放：distance A/B 差值实测", "check": { "kind": "camera", "event": "zoom", "field": "distance", "minDelta": 0.05 } },
    { "id": "life.camera.reset", "dimension": "interactionTruth", "points": 3, "description": "重置后 camera ≈ canonical", "check": { "kind": "camera", "event": "reset", "field": "yaw", "maxDeviation": 0.05 } },
    { "id": "life.mode.a11y", "dimension": "accessibility", "points": 5, "description": "模式按钮可访问（tab/button）", "check": { "kind": "count", "filter": { "role": "button", "idPrefix": "pli.lifeview.mode." }, "range": [4, 4] } },
    { "id": "life.style.truth", "dimension": "pixelStyleTruth", "points": 3, "description": "Stage computed bg 非纯黑（luma≥0.08）", "check": { "kind": "style-truth", "idPrefix": "pli.lifeview.stage", "notDarkBg": true } },
    { "id": "life.warm.pixels", "dimension": "pixelStyleTruth", "points": 2, "description": "数字空间但非 debug：cool accent 占比受限", "check": { "kind": "pixel-style", "surface": "lifeview" } }
  ]
}