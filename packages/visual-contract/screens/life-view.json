{
  "screen": "life-view",
  "version": 1,
  "dimensions": { "petIdentity": 20, "composition": 20, "hierarchy": 15, "surface": 10, "contentPurity": 10, "interaction": 10, "accessibility": 5, "runtimeTruth": 10 },
  "thresholds": { "pass": 92, "heroPass": 95 },
  "critical": [
    "life.stage", "life.twin.present", "life.anchors", "life.rotate", "life.content.purity",
    "life.3d.wireframe", "life.3d.no-fallback", "life.mode.now"
  ],
  "checks": [
    { "id": "life.stage", "dimension": "petIdentity", "points": 6, "description": "Twin Space Stage 存在", "check": { "kind": "element", "idPrefix": "pli.lifeview.stage", "minHeight": 200 } },
    { "id": "life.twin.present", "dimension": "petIdentity", "points": 8, "description": "个体 3D Twin 存在", "check": { "kind": "element", "idPrefix": "pli.lifeview.twin", "minHeight": 200 } },
    { "id": "life.anchors", "dimension": "petIdentity", "points": 6, "description": "锚点 2–4 个（默认不铺满）", "check": { "kind": "element", "idPrefix": "pli.lifeview.anchor.*", "count": [2, 4] } },
    { "id": "life.stage.ratio", "dimension": "composition", "points": 8, "description": "3D Stage ≥52% 内容高", "check": { "kind": "ratio", "target": "pli.lifeview.stage", "region": "content", "property": "height", "range": [0.52, 0.72] } },
    { "id": "life.twin.center", "dimension": "composition", "points": 6, "description": "Twin 水平居中偏差 ≤10%", "check": { "kind": "center", "target": "pli.lifeview.twin", "region": "viewport", "axis": "x", "tolerance": 0.1 } },
    { "id": "life.stage.dominant", "dimension": "composition", "points": 6, "description": "3D Stage 面积占比 22–42% 视口", "check": { "kind": "ratio", "target": "pli.lifeview.stage", "region": "viewport", "property": "area", "range": [0.22, 0.42] } },
    { "id": "life.mode.now", "dimension": "hierarchy", "points": 5, "description": "模式「此刻」可用", "check": { "kind": "element", "idPrefix": "pli.lifeview.mode.now" } },
    { "id": "life.modes", "dimension": "hierarchy", "points": 5, "description": "模式切换器存在（此刻/趋势/时间线/外观）", "check": { "kind": "element", "idPrefix": "pli.lifeview.mode.*", "count": [4, 4] } },
    { "id": "life.panel", "dimension": "hierarchy", "points": 5, "description": "事实面板存在", "check": { "kind": "element", "idPrefix": "pli.lifeview.panel" } },
    { "id": "life.surface", "dimension": "surface", "points": 10, "description": "Above-fold 大 Card ≤2", "check": { "kind": "surface", "max": 2, "minArea": 20000, "aboveFold": true } },
    { "id": "life.mode.a11y", "dimension": "accessibility", "points": 5, "description": "模式按钮可访问（tab/button）", "check": { "kind": "element", "idPrefix": "pli.lifeview.mode.*", "count": [4, 4] } },
    { "id": "life.rotate", "dimension": "interaction", "points": 5, "description": "旋转可用（interactive stage）", "check": { "kind": "interaction", "id": "pli.lifeview.stage" } },
    { "id": "life.controls", "dimension": "interaction", "points": 5, "description": "缩放/重置控制存在", "check": { "kind": "element", "idPrefix": "pli.lifeview.control.*", "count": [2, 4] } },
    { "id": "life.content.purity", "dimension": "contentPurity", "points": 10, "description": "Owner 文本无 raw internal terms", "check": { "kind": "text-free", "tokens": ["BW-", "OWNER_REPORTED", "STRESS_RECOVERY", "OPEN", "provider_", "model_id", "event_key", "PLI-"] } },
    { "id": "life.3d.manifest", "dimension": "runtimeTruth", "points": 4, "description": "3D Scene Manifest 存在", "check": { "kind": "manifest", "field": "ready", "truthy": true, "unlessPlatform": ["android"] } },
    { "id": "life.3d.wireframe", "dimension": "runtimeTruth", "points": 3, "description": "wireframe = false", "check": { "kind": "manifest", "field": "wireframe", "eq": false } },
    { "id": "life.3d.no-fallback", "dimension": "runtimeTruth", "points": 3, "description": "fallbackUsed = false（真实 3D）", "check": { "kind": "manifest", "field": "fallbackUsed", "eq": false, "unlessPlatform": ["android"] } }
  ]
}
