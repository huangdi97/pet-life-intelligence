{
  "$schema": "https://example.com/ui-tokens.schema.json",
  "version": "2.0.0",
  "brand": {
    "name": "Pet Life Intelligence",
    "direction": "warm / professional / trusted / calm / long-term companion / health-tech",
    "anti_direction": [
      "cheap pet store",
      "childish cartoon",
      "hospital HIS",
      "AI tech-blue dashboard",
      "heavy gradients",
      "full glassmorphism",
      "overly cute",
      "emoji flood"
    ]
  },
  "color": {
    "bg": {
      "canvas": "#FAF8F5",
      "surface": "#FFFFFF",
      "surface_muted": "#F3F0EB",
      "surface_strong": "#ECE8E0"
    },
    "ink": {
      "primary": "#2B2723",
      "secondary": "#57504A",
      "muted": "#7C7369",
      "disabled": "#B5ACA0"
    },
    "line": {
      "default": "#E8E2D9",
      "strong": "#D8D0C4",
      "focus": "#61795C"
    },
    "primary": {
      "50": "#F3F6F2",
      "100": "#E4EAE0",
      "200": "#C9D4C3",
      "300": "#A6B7A0",
      "400": "#81977B",
      "500": "#61795C",
      "600": "#4E6349",
      "700": "#3D4F3A",
      "800": "#2F3D2D",
      "900": "#222C21"
    },
    "accent": {
      "50": "#FBF6EE",
      "100": "#F5E9D6",
      "200": "#EAD3A8",
      "300": "#DBB275",
      "400": "#C98A3D",
      "500": "#B9762A",
      "600": "#9C5F22",
      "700": "#7A4919"
    },
    "semantic": {
      "ok": "#4E7A5A",
      "ok_bg": "#EDF3EE",
      "notice": "#B08A2E",
      "notice_bg": "#FBF4E2",
      "monitor": "#61795C",
      "monitor_bg": "#F3F6F2",
      "vet_soon": "#C07A2D",
      "vet_soon_bg": "#FDF2E3",
      "urgent": "#C2503C",
      "urgent_bg": "#FBECE7",
      "emergency": "#B42318",
      "emergency_bg": "#FBEAE6",
      "info": "#3E7C83",
      "info_bg": "#E8F1F2",
      "danger": "#B42318",
      "danger_bg": "#FBEAE6",
      "success": "#4E7A5A",
      "success_bg": "#EDF3EE",
      "error": "#B42318",
      "error_bg": "#FBEAE6",
      "disabled": "#B5ACA0"
    }
  },
  "typography": {
    "font_family": {
      "base": "Inter, \"PingFang SC\", \"Microsoft YaHei\", system-ui, -apple-system, sans-serif",
      "display": "Inter, \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif"
    },
    "scale": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px"
    },
    "line_height": {
      "tight": 1.25,
      "normal": 1.5,
      "loose": 1.75
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "sm": "8px",
    "md": "10px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "pill": "999px"
  },
  "elevation": {
    "none": "none",
    "sm": "0 1px 2px rgba(43,39,35,0.06)",
    "md": "0 2px 8px rgba(43,39,35,0.08)",
    "lg": "0 8px 24px rgba(43,39,35,0.10)",
    "focus": "0 0 0 3px rgba(97,121,92,0.25)"
  },
  "border": {
    "width_thin": "1px",
    "width_thick": "2px",
    "color_default": "#E8E2D9",
    "color_strong": "#D8D0C4",
    "color_focus": "#61795C"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)"
    }
  },
  "icon": {
    "system": "neutral stroke icon set (Lucide-style), 1.5px stroke, round caps",
    "primary_icon": "paw outline",
    "navigation": ["today", "timeline", "pet", "agent", "more"],
    "risk": ["circle", "info", "eye", "clock", "alert-triangle", "siren"]
  },
  "risk_status": {
    "NORMAL": {
      "label": "正常",
      "label_en": "Normal",
      "color": "ok",
      "icon": "circle"
    },
    "NOTICE": {
      "label": "注意",
      "label_en": "Notice",
      "color": "notice",
      "icon": "info"
    },
    "MONITOR": {
      "label": "观察",
      "label_en": "Monitor",
      "color": "monitor",
      "icon": "eye"
    },
    "VET_SOON": {
      "label": "建议就医",
      "label_en": "Vet Soon",
      "color": "vet_soon",
      "icon": "clock"
    },
    "URGENT": {
      "label": "紧急",
      "label_en": "Urgent",
      "color": "urgent",
      "icon": "alert-triangle"
    },
    "EMERGENCY": {
      "label": "危及生命",
      "label_en": "Emergency",
      "color": "emergency",
      "icon": "siren"
    }
  },
  "semantic_state": {
    "loading": { "label": "加载中" },
    "skeleton": { "label": "占位" },
    "empty": { "label": "暂无内容" },
    "populated": { "label": "有内容" },
    "error": { "label": "出错了" },
    "offline": { "label": "离线" },
    "permission_denied": { "label": "没有访问权限" },
    "not_found": { "label": "页面不存在" },
    "external_blocked": { "label": "该服务暂未开放" },
    "retry": { "label": "重试" }
  },
  "layout": {
    "breakpoints": {
      "xs": "360px",
      "sm": "390px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1440px"
    },
    "content_max_width": "880px",
    "nav_height_desktop": "56px",
    "nav_height_mobile": "64px"
  },
  "touch": {
    "min_target": "44px",
    "min_gap": "8px"
  },
  "grid": {
    "container_max": "1200px",
    "columns_mobile": "4",
    "columns_desktop": "12",
    "gutter": "16px"
  },
  "breakpoint": {
    "xs": "360px",
    "sm": "390px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px"
  },
  "z_index": {
    "base": "0",
    "sticky": "100",
    "dropdown": "200",
    "sheet": "300",
    "modal": "400",
    "toast": "500"
  }
}